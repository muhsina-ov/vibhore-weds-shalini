{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vibhore-weds-shalini",
  "compatibility_date": "2026-09-06",
  "assets": {
    "directory": ".",
    "exclude": [
      ".git/**",
      ".git*",
      "node_modules/**",
      "*.ORIGINAL",
      "*.py",
      "*.tmp",
      "*.log"
    ]
  }
}
